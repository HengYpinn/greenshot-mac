{
  "manifest_version": 3,
  "name": "Greenshot for Mac (Community) Companion",
  "short_name": "Greenshot Companion",
  "version": "1.0.0",
  "description": "Unofficial companion for Greenshot for Mac (Community): sends the visible page and its address to Greenshot.",
  "key": "",
  "browser_specific_settings": {
    "gecko": {
      "id": "companion@greenshot-mac.github.io",
      "strict_min_version": "126.0"
    }
  },
  "permissions": [
    "activeTab",
    "tabs",
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "Greenshot for Mac (Community) Companion",
    "default_popup": "popup/popup.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
